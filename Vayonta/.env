# Backend API-nin kökü. Dev-də Vite proxy /api-ni backend-ə yönləndirir.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application).
# "Authorized JavaScript origins" siyahısına http://localhost:5173 əlavə olunmalıdır.
# Bu ID backend-dəki voyanta.oauth.google.client-id ilə EYNİ olmalıdır.
VITE_GOOGLE_CLIENT_ID=271303617766-v851cofvnc2t6qn2cee2minseps0h4pj.apps.googleusercontent.com
